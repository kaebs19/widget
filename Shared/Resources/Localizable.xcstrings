    },
    "عند الإيقاف تُكتب بخط النص الذي اخترته" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, they use the text font you chose"
          }
        }
      }
    },
    "عند التفعيل، نستبعد قيمة الالتزامات التي أدخلتها من المبلغ المتاح لحساب حصة اليوم فقط. هذا حجز حسابي اختياري، ولا يسدّد الالتزامات أو يخصم أموالًا من حسابك البنكي." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, the obligations you entered are subtracted from the available amount, only to calculate today’s share. This is an optional on-paper reservation; it doesn’t pay obligations or deduct money from your bank account."
          }
        }
      }
    },
