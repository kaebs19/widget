    "عنّابي" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burgundy"
          }
        }
      }
    },
    "عند إيقاف تخصيص يوم يُستخدم الهدف الأساسي من إعدادات الصحة. تُحسب الاستمرارية وتقويم الإنجاز وفق جدول الأهداف الحالي، بما فيه الأيام السابقة المعروضة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a day isn’t customized, the base goal from Health settings is used. Streaks and the progress calendar follow the current goal schedule, including past days shown."
          }
        }
      }
    },
    "عند الأذان" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At Adhan"
