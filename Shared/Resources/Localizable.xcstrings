        }
      }
    },
    "يبقى في يومه حتى لو كان إجازة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stays on its day even on the weekend"
          }
        }
      }
    },
    "يتجدد الاشتراك تلقائياً بنفس السعر في نهاية كل فترة ما لم يُلغَ قبل ٢٤ ساعة على الأقل من موعد التجديد، ويُخصم المبلغ من حساب Apple. تُدار الاشتراكات وتُلغى من إعدادات حسابك في App Store. عند إلغاء التجربة المجانية قبل انتهائها لا يُخصم شيء." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The subscription renews automatically at the same price at the end of each period unless cancelled at least 24 hours before renewal, and is charged to your Apple Account. Manage or cancel it in your App Store account settings. Cancel the free trial before it ends and you won't be charged."
          }
        }
      }
    },
    "يُحفظ موقعك على جهازك فقط" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is saved only on your device"
          }
        }
      }
    },
    "يستبدل الشكل الحالي لكل الودجات بهذا الشكل." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaces the current look of every widget with this one."
          }
        }
      }
    },
    "يستخدم خط النص الذي اخترته في تبويب «النص»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the text font you chose in the Text tab."
          }
        }
      }
    },
    "يُصرف حافز يوم ٥ من كل شهر ميلادي." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hafiz is paid on the 5th of each Gregorian month."
          }
        }
      }
    },
    "يصلك تنبيه %@ في اليوم السابق." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ll get an alert at %@ the day before."
          }
        }
      }
    },
    "يظهر في «تعديل الودجت» لتختاره لأي ودجت." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It appears in “Edit Widget” so you can pick it for any widget."
          }
        }
      }
    },
    "يكمل %@ سنة" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns %@"
          }
        }
      }
    },
    "يكمل %@ سنة · %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns %1$@ · %2$@"
          }
        }
      }
    },
    "يكمل %@ سنة في الموعد القادم" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns %@ on the next date"
          }
        }
      }
    },
    "يوافق إجازة %@، وغالباً يُقدَّم الصرف قبلها. إذا أُعلن موعده عدّله من «موعد استثنائي»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls in the %@ holiday, so payment usually comes earlier. If a date is announced, set it in “One-Time Date”."
          }
        }
      }
    },
    "يُودَع الدعم يوم ١٠ من كل شهر ميلادي." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support is deposited on the 10th of each Gregorian month."
          }
        }
      }
    },
    "يُودَع الضمان الاجتماعي المطور يوم ١ من كل شهر ميلادي، ويُقدَّم إذا صادف إجازة." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Social Security is deposited on the 1st of each Gregorian month, earlier if it falls on a holiday."
          }
        }
      }
    },
