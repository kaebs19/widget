      }
    },
    "يتجدد الاشتراك تلقائياً بنفس السعر في نهاية كل فترة ما لم يُلغَ قبل ٢٤ ساعة على الأقل من موعد التجديد، ويُخصم المبلغ من حساب Apple. تُدار الاشتراكات وتُلغى من إعدادات حسابك في App Store. عند إلغاء التجربة المجانية قبل انتهائها لا يُخصم شيء." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The subscription renews automatically at the same price at the end of each period unless cancelled at least 24 hours before renewal, and is charged to your Apple Account. Manage or cancel it in your App Store account settings. Cancel the free trial before it ends and you won't be charged."
          }
        }
      }
